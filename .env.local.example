# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Anthropic Claude API (NEWS-11: automatic LLM categorization)
# Server-only. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key

# Vercel Cron Secret (NEWS-5: Scheduler authentication)
# Generate with: openssl rand -base64 32
#
# NOTE: vercel.json crons run in PRODUCTION only. In development nothing scrapes on a
# schedule — trigger a scrape by hand with POST /api/sources/[id]/scrape. The absence of
# scheduled scraping locally is expected, not a bug.
#
# Use a DIFFERENT value here from production. Preview URLs are shareable, so a leak from a
# lower-trust environment must not hand out production's cron credential.
CRON_SECRET=your-cron-secret

# ---------------------------------------------------------------------------
# Do not fill these in by hand. Run:
#
#   vercel env pull .env.local
#
# Development and Preview both resolve to the news-scraper-dev Supabase project
# (cekgyjynxgyktzouepkp). Only Production points at news-scraper (xvkviaapboambbvsvnuz).
# ---------------------------------------------------------------------------
